# One KoolSupport CurseForge project / one installable ZIP / seven sibling WoW addons.
# Optional in the game UI does NOT require a separate CurseForge project.
package-as: KoolSupport
enable-nolib-creation: no
move-folders:
    KoolSupport/addons/KoolSupport: KoolSupport
    KoolSupport/addons/KSMacros: KSMacros
    KoolSupport/addons/KSSupportSessions: KSSupportSessions
    KoolSupport/addons/KSStealth: KSStealth
    KoolSupport/addons/KSAfflictions: KSAfflictions
    KoolSupport/addons/KSCampfireChat: KSCampfireChat
    KoolSupport/addons/KSThreat: KSThreat
ignore:
    - docs
    - tests
    - scripts
    - preview
    - legacy
    - .github
    - README.md
license-output: LICENSE
