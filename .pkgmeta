# One CurseForge installable addon folder with six in-game optional module folders.
# Source modules remain separate for engineering tests; distribution nests them.
package-as: KoolSupport
enable-nolib-creation: no
move-folders:
    KoolSupport/addons/KoolSupport: KoolSupport
    KoolSupport/addons/KSMacros: KoolSupport/Modules/KSMacros
    KoolSupport/addons/KSSupportSessions: KoolSupport/Modules/KSSupportSessions
    KoolSupport/addons/KSStealth: KoolSupport/Modules/KSStealth
    KoolSupport/addons/KSAfflictions: KoolSupport/Modules/KSAfflictions
    KoolSupport/addons/KSCampfireChat: KoolSupport/Modules/KSCampfireChat
    KoolSupport/addons/KSThreat: KoolSupport/Modules/KSThreat
ignore:
    - docs
    - tests
    - scripts
    - preview
    - legacy
    - .github
    - README.md
    # Nested modules are scripts, not separately loadable addons.
    - addons/KSMacros/KSMacros.toc
    - addons/KSSupportSessions/KSSupportSessions.toc
    - addons/KSStealth/KSStealth.toc
    - addons/KSAfflictions/KSAfflictions.toc
    - addons/KSCampfireChat/KSCampfireChat.toc
    - addons/KSThreat/KSThreat.toc
license-output: LICENSE
